// Minimal fastfetch config
// palette: house colors (hyprland / quickshell / wofi / nvim haimiya)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "/home/sky/.config/fastfetch/Mio.png",
    "width": 24,
    "height": 11,
    "padding": { "right": 2 }
  },

  "display": {
    "color": {
      "keys": "#81A1C1",
      "title": "#A7CBEB",
      "output": "#DCE6F2",
      "separator": "#62829F"
    }
  },

  "modules": [
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "wm",
    "cpu",
    "memory",
    "colors"
  ]
}
